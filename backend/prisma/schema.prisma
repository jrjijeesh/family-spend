// backend/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

model Household {
  id        String    @id @default(uuid())
  name      String
  currency  String    @default("INR")
  createdAt DateTime  @default(now())
  users     User[]
  expenses  Expense[]
  budgets   Budget[]
}

model User {
  id           String    @id @default(uuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(MEMBER)
  refreshToken String?
  createdAt    DateTime  @default(now())
  expenses     Expense[]

  @@index([householdId])
}

model Expense {
  id             String    @id @default(uuid())
  householdId    String
  household      Household @relation(fields: [householdId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  amountPaise    BigInt    // ₹250.50 stored as 25050
  category       String
  paymentMode    String
  merchant       String?
  notes          String?
  spentAt        DateTime  @db.Date
  idempotencyKey String    @unique // Generated by mobile app (UUID v4)
  deletedAt      DateTime? // Soft delete
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([householdId, spentAt])
  @@index([householdId, category])
}

model Budget {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  category    String
  month       String    // YYYY-MM
  limitPaise  BigInt

  @@unique([householdId, category, month])
}

model AuditLog {
  id          String   @id @default(uuid())
  householdId String
  actorId     String
  action      String   // CREATE_EXPENSE, DELETE_EXPENSE, UPDATE_BUDGET
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([householdId, createdAt])
}